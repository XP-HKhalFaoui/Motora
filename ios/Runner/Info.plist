<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>fr</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>fr</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>Motora</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Motora</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- image_picker reaches the camera and the photo library (odometer
	     photos, invoice and document scans, vehicle photos). iOS kills the
	     app on the spot if the matching usage string is missing. -->
		<key>NSCameraUsageDescription</key>
		<string>Motora utilise l’appareil photo pour photographier votre compteur, vos factures et vos documents.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Motora accède à vos photos pour joindre une image de compteur, une facture ou un document à votre carnet.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Motora enregistre dans vos photos les documents que vous exportez.</string>
		<!-- Supabase auth callback: password-reset and magic-link emails
		     redirect here so the session lands in the app instead of
		     dead-ending in a browser tab. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.motora.app</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.motora.app</string>
				</array>
			</dict>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Every screen is designed for portrait; landscape would just stretch
	     the fixed-size gauge and segmented header. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
